# ============================================================
# Agentic Scheduler for Flight Schedule Pro — Environment Variables
# Copy to .env and fill in values for local development.
# NEVER commit .env to source control.
# ============================================================

# --- FSP API ---
FSP_API_BASE_URL=https://development-fsp.azure-api.net
FSP_CORE_BASE_URL=https://api-develop.flightschedulepro.com
FSP_CURRICULUM_BASE_URL=https://curriculum-api-develop.flightschedulepro.com
FSP_SUBSCRIPTION_KEY=your-subscription-key
FSP_ENVIRONMENT=develop

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/fsp_scheduler

# --- Azure Service Bus ---
AZURE_SERVICE_BUS_NAMESPACE=your-namespace
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key
AZURE_SERVICE_BUS_POLL_QUEUE=poll-jobs
AZURE_SERVICE_BUS_CHANGE_QUEUE=change-events
AZURE_SERVICE_BUS_SUGGESTION_QUEUE=suggestion-results

# --- Anthropic / LLM ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Auth ---
JWT_SECRET=your-jwt-secret-min-32-chars

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URL=https://fsp-scheduler-kv.vault.azure.net

# --- SMS Provider ---
SMS_PROVIDER=azure
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15550000000
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-key

# --- Observability ---
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://eastus.in.applicationinsights.azure.com/

# --- Polling ---
POLLING_RATE_LIMIT=55
TIER1_POLL_INTERVAL_SECONDS=60
TIER2_POLL_INTERVAL_SECONDS=300
TIER3_POLL_INTERVAL_SECONDS=1800

# --- Suggestions ---
SUGGESTION_EXPIRY_HOURS=24

# --- Server ---
PORT=3000
WORKER_PORT=3001
NODE_ENV=development
